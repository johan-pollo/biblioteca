# Genera SECRET_KEY con: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/biblioteca_db
TEST_DATABASE_URL=postgresql+psycopg://biblioteca:biblioteca_dev@localhost:5432/biblioteca_test
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=[]
ENVIRONMENT=dev

# Cloudinary (portadas de libros)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
